    {
      "id": "arithmetic-percentage-increase-001",
      "subject": "Quantitative aptitude",
      "topic": "Percentage",
      "difficulty": "easy",
      "status": "preview",
      "sourceType": "original_demo",
      "sourceReference": null,
      "correctOptionIndex": 2,
      "languages": {
        "en": {
          "question": "A value increases from 80 to 100. What is the percentage increase?",
          "options": [
            "20%",
            "22.5%",
            "25%",
            "30%"
          ],
          "explanation": "Increase = 100 − 80 = 20. Percentage increase = (20 ÷ 80) × 100 = 25%."
        },
        "te": {
          "question": "ఒక విలువ 80 నుంచి 100కి పెరిగింది. శాతం పెరుగుదల ఎంత?",
          "options": [
            "20%",
            "22.5%",
            "25%",
            "30%"
          ],
          "explanation": "పెరుగుదల = 100 − 80 = 20. శాతం పెరుగుదల = (20 ÷ 80) × 100 = 25%."
        }
      }
    },
